function VField:SetTheme(name)
	name = ALIAS[name] or name
	local t = THEMES[name]
	if not t then return end
	currentTheme, rainbowOn = name, false
	themeToken += 1
	local my = themeToken
	local from = {}
	for _, k in ipairs(THEME_KEYS) do from[k] = COLORS[k] end
	task.spawn(function()
		local t0 = os.clock()
		while themeToken == my and not dead do
			local a = math.clamp((os.clock() - t0) / 0.4, 0, 1)
			for _, k in ipairs(THEME_KEYS) do COLORS[k] = from[k]:Lerp(t[k], a) end
			runHooks()
			if a >= 1 then break end
			task.wait()
		end
	end)
end
function VField:SetRainbow(on)
	if on == rainbowOn then return end
	if not on then rainbowOn = false VField:SetTheme(currentTheme) return end
	rainbowOn = true
	themeToken += 1
	task.spawn(function()
		while rainbowOn and not dead do
			local h = (os.clock() * 0.12) % 1
			COLORS.Accent, COLORS.Bright, COLORS.Soft = Color3.fromHSV(h, 0.6, 1), Color3.fromHSV(h, 0.35, 1), Color3.fromHSV(h, 0.65, 0.3)
			runHooks()
			task.wait(0.05)
		end
	end)
end
function VField:SetAccent(c)
	rainbowOn = false
	themeToken += 1
	COLORS.Accent, COLORS.Bright, COLORS.Soft = c, c:Lerp(Color3.new(1, 1, 1), 0.4), c:Lerp(COLORS.Background, 0.75)
	runHooks()
end
function VField:RegisterTheme(name, tbl) defineTheme(name, tbl) end
function VField:GetThemes()
	local out = {}
	for _, n in ipairs(THEME_ORDER) do out[#out + 1] = n end
	out[#out + 1] = "Rainbow"
	return out
end
function VField:GetFlag(f) return VField.Flags[f] end
function VField:Notify(c) if VField.Window then VField.Window:Notify(c) end end
function VField:LoadConfiguration() if VField.Window then return VField.Window:LoadConfiguration() end end
function VField:GetHWID()
	local ok, id = pcall(function() return game:GetService("RbxAnalyticsService"):GetClientId() end)
	return ok and id or "unknown"
end
function VField:SetColor(key, c)
	if COLORS[key] ~= nil and typeof(c) == "Color3" then COLORS[key] = c runHooks() end
end

