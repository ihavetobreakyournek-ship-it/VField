					TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, OPT_H), ZIndex = 7}, panel), {BackgroundColor3 = "Panel", TextColor3 = "Text", PlaceholderColor3 = "Muted"})
				make("UIPadding", {PaddingLeft = UDim.new(0, 8)}, sbox)
				stroke(sbox, COLORS.Line, 0.3, 1)
			end
			local lst = P(make("ScrollingFrame", {BorderSizePixel = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2,
				Position = UDim2.fromOffset(0, SB), Size = UDim2.new(1, 0, 1, -SB), ZIndex = 7}, panel), {BackgroundColor3 = "Panel"})
			stroke(lst, COLORS.Line, 0.3, 1)
			list(lst, 2)
			local isOpen, buttons = false, {}
			local function setText()
				local v = getValue()
				local txt
				if multi then txt = #v == 0 and "None" or (#v <= 2 and table.concat(v, ", ") or (#v .. " selected"))
				else txt = v or "None" end
				st.Text = txt .. "   " .. (isOpen and "▴" or "▾")
			end
			local function paintOpts()
				for o, b in pairs(buttons) do
