	---------------------------------------------------------------
	local function applyFilter()
		local q = sBox.Text:lower()
		local first
		for _, tab in ipairs(win.Tabs) do
			local tabMatches = false
			for _, sec in ipairs(tab.Sections) do
				local any = false
				for _, r in ipairs(sec.Rows) do
					r.match = q == "" or r.key:find(q, 1, true) ~= nil or sec.NameLower:find(q, 1, true) ~= nil
					r.row.Visible = r.match and not r.hidden
					if r.match then any = true end
				end
				sec.Container.Visible = any or q == ""
				sec.Items.Visible = q ~= "" or not sec.Collapsed
				if any then tabMatches = true end
			end
			tab.Label.TextTransparency = (q ~= "" and not tabMatches) and 0.6 or 0
			if tabMatches and not first then first = tab end
		end
		if q ~= "" and first and win.ActiveTab and win.ActiveTab ~= first then
			local here = false
			for _, sec in ipairs(win.ActiveTab.Sections) do
				for _, r in ipairs(sec.Rows) do if r.match then here = true break end end
				if here then break end
			end
			if not here then first.Select() end
		end
	end
	sBox:GetPropertyChangedSignal("Text"):Connect(applyFilter)

