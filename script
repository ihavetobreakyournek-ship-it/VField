	local function sliderCore(parent, pos, size, minV, maxV, inc, init, onChange, onVisual, zi)
		local track = P(make("Frame", {BorderSizePixel = 0, Position = pos, Size = size, ZIndex = zi}, parent), {BackgroundColor3 = "Panel"})
		stroke(track, COLORS.Line, 0.5, 1)
		local fill = P(make("Frame", {BorderSizePixel = 0, ZIndex = zi + 1}, track), {BackgroundColor3 = "Accent"})
		local ks = COMPACT and 20 or 12
		local knob = P(make("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Size = UDim2.fromOffset(ks, ks), ZIndex = zi + 2}, track), {BackgroundColor3 = "Text"})
		local kst = stroke(knob, COLORS.Accent, 0, 2)
		hook(function() kst.Color = COLORS.Accent end)
		local hit = make("TextButton", {AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(1, 0, 0, COMPACT and 40 or 24), Text = "", ZIndex = zi + 3}, track)
		local obj, value, lastTick = {Track = track}, init, 0
		function obj.Get() return value end
		function obj.Set(n, silent)
			local snapped = minV + math.floor(((n - minV) / inc) + 0.5) * inc
			value = tonumber(string.format("%.10g", math.clamp(snapped, minV, maxV)))
			local r = (value - minV) / (maxV - minV)
			fill.Size = UDim2.new(r, 0, 1, 0)
			knob.Position = UDim2.new(r, 0, 0.5, 0)
			if onVisual then onVisual(value) end
			if not silent and onChange then task.spawn(onChange, value) end
		end
		function obj.Drag(p)
			local w = track.AbsoluteSize.X
			if w <= 0 then return end
			local prev = value
			obj.Set(minV + math.clamp((p.X - track.AbsolutePosition.X) / w, 0, 1) * (maxV - minV), true)
			if value ~= prev then
				if onChange then task.spawn(onChange, value) end
				local now = os.clock()
				if now - lastTick > 0.05 then lastTick = now playSound("Tick", 1, 0.8 + ((value - minV) / (maxV - minV)) * 0.9) end
			end
		end
		function obj.Release() tween(knob, 0.15, {Size = UDim2.fromOffset(ks, ks)}) end
		hit.InputBegan:Connect(function(i)
			if isPress(i) then
				win.ActiveDrag = obj
				tween(knob, 0.12, {Size = UDim2.fromOffset(ks + 4, ks + 4)})
				obj.Drag(pointer(i))
			end
		end)
		obj.Set(init, true)
		return obj
	end

	local function makeRow(section, config, reserved, baseH, extraBottom)
		extraBottom = extraBottom or 0
		local info = {h = baseH, open = 0, vc = {}}
		local row = P(make("Frame", {BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, baseH), ZIndex = 4, LayoutOrder = tonumber(config.LayoutOrder) or 0}, section.Items),
			{BackgroundColor3 = "Raised"})
		local rs = stroke(row, COLORS.Line, 0.5, 1)
		hook(function() rs.Color = COLORS.Line end)
		row.MouseEnter:Connect(function() tween(row, 0.16, {BackgroundColor3 = COLORS.Hover}) tween(rs, 0.16, {Transparency = 0.2}) end)
		row.MouseLeave:Connect(function() tween(row, 0.18, {BackgroundColor3 = COLORS.Raised}) tween(rs, 0.18, {Transparency = 0.5}) end)
		attachTip(row, config.Tooltip)
		local nameSize, descSize = 12 + BOOST, 10 + BOOST
		local nameH = nameSize + 6
		local name = T(row, tostring(config.Name or ""), nameSize, "Text", FONT_BOLD, UDim2.fromOffset(13, 8), UDim2.new(1, -(13 + reserved), 0, nameH))
		name.TextTruncate, name.ZIndex, name.RichText = Enum.TextTruncate.AtEnd, 5, true
		local desc = T(row, "", descSize, "Muted", FONT, UDim2.fromOffset(13, 8 + nameH + 1), UDim2.new(1, -(13 + reserved), 0, 14))
		desc.TextWrapped, desc.TextYAlignment, desc.ZIndex, desc.RichText = true, Enum.TextYAlignment.Top, 5, true
		local function placeVC(inst)
			inst.Position = UDim2.new(inst.Position.X.Scale, inst.Position.X.Offset, 0, (info.h - extraBottom) / 2)
		end
		function info.VC(inst)
			inst.AnchorPoint = Vector2.new(inst.AnchorPoint.X, 0.5)
			info.vc[#info.vc + 1] = inst
			placeVC(inst)
		end
		local function relayout()
			local textW = (info.w or ROW_W) - 13 - reserved - 10
			if desc.Text ~= "" then
				local h = math.ceil(measure(desc.Text, descSize, FONT, textW)) + 1
				name.Position, name.Size = UDim2.fromOffset(13, 8), UDim2.new(1, -(13 + reserved), 0, nameH)
				desc.Visible = true
				desc.Size = UDim2.new(1, -(13 + reserved), 0, h)
				info.h = math.max(baseH, 8 + nameH + 2 + h + 10 + extraBottom)
			else
				desc.Visible = false
				name.Position = UDim2.fromOffset(13, 0)
				name.Size = UDim2.new(1, -(13 + reserved), 0, baseH - extraBottom)
				info.h = baseH
			end
			row.Size = UDim2.new(1, 0, 0, info.h + info.open)
			for _, v in ipairs(info.vc) do placeVC(v) end
			if info.onLayout then info.onLayout() end
		end
		desc.Text = tostring(config.Description or "")
		relayout()
		row:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			local w = row.AbsoluteSize.X / math.max(win.CurScale, 0.01)
			if math.abs(w - (info.w or ROW_W)) > 1 then info.w = w relayout() end
		end)
		function info.Resize(extra, animate)
			info.open = extra
			local goal = UDim2.new(1, 0, 0, info.h + extra)
			if animate then tween(row, 0.22, {Size = goal}) else row.Size = goal end
		end
		local rec = {row = row, key = strip((config.Name or "") .. " " .. (config.Description or "")):lower(), hidden = false, match = true}
		info.rec = rec
		section.Rows[#section.Rows + 1] = rec
		return row, {SetTitle = function(t) name.Text = tostring(t or "") end, SetDescription = function(t) desc.Text = tostring(t or "") relayout() end}, info
	end

	local function common(row, lab, info, extra, config)
		extra = extra or {}
		extra.Row, extra.SetTitle, extra.SetDescription = row, lab.SetTitle, lab.SetDescription
		extra.SetVisible = function(v) info.rec.hidden = not v row.Visible = v and info.rec.match end
		local blocker
		extra.SetDisabled = function(d)
			if d and not blocker then
				blocker = P(make("Frame", {BorderSizePixel = 0, BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1), ZIndex = 30, Active = true}, row), {BackgroundColor3 = "Background"})
			end
			if blocker then blocker.Visible = d end
		end
		extra.Destroy = function() row:Destroy() info.rec.hidden = true info.rec.match = false end
		if config and config.Disabled then extra.SetDisabled(true) end
		if not extra.Set then
			extra.Set = function(t)
				if type(t) == "table" then
					if t.Title or t.Name then lab.SetTitle(t.Title or t.Name) end
					if t.Content or t.Description then lab.SetDescription(t.Content or t.Description) end
				else lab.SetTitle(t) end
			end
		end
		for k, f in pairs(extra) do
			if type(f) == "function" then
				extra[k] = function(a, ...)
					if a == extra then return f(...) end
					return f(a, ...)
				end
			end
		end
		return extra
	end

