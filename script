-- FILE HELPERS (all optional, silently skipped if the executor lacks them)
---------------------------------------------------------------------
local canFS = (writefile and readfile and isfile) ~= nil
local function ensureFolder(path)
	if not (makefolder and isfolder) then return end
	local acc = ""
	for part in path:gmatch("[^/]+") do
		acc = acc == "" and part or (acc .. "/" .. part)
		if not isfolder(acc) then pcall(makefolder, acc) end
	end
end
local function fsWrite(path, data)
	if not writefile then return false end
	ensureFolder(path:match("^(.*)/") or "")
	return (pcall(writefile, path, data))
end
local function fsRead(path)
	if readfile and isfile and isfile(path) then
		local ok, d = pcall(readfile, path)
		if ok then return d end
	end
end

