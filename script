		function section:CreateRangeSlider(config)
			local row, lab, info = makeRow(self, config, COMPACT and 130 or 150, COMPACT and 80 or 70, COMPACT and 38 or 26)
			local minV, maxV = config.Range[1], config.Range[2]
			local inc = (config.Increment and config.Increment > 0) and config.Increment or 1
			local cv = config.CurrentValue or {}
			local lo, hi = cv[1] or minV, cv[2] or maxV
			local vl = T(row, "", 10 + BOOST, "Bright", FONT_BOLD, UDim2.new(1, -153, 0, 7), UDim2.fromOffset(140, 20))
			vl.ZIndex, vl.TextXAlignment = 5, Enum.TextXAlignment.Right
			local track = P(make("Frame", {BorderSizePixel = 0, Position = UDim2.new(0, 13, 1, COMPACT and -26 or -21), Size = UDim2.new(1, -26, 0, COMPACT and 8 or 6), ZIndex = 5}, row), {BackgroundColor3 = "Panel"})
			stroke(track, COLORS.Line, 0.5, 1)
			local fill = P(make("Frame", {BorderSizePixel = 0, ZIndex = 6}, track), {BackgroundColor3 = "Accent"})
			local ks = COMPACT and 20 or 12
			local function knob()
				local k = P(make("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Size = UDim2.fromOffset(ks, ks), ZIndex = 7}, track), {BackgroundColor3 = "Text"})
				local st = stroke(k, COLORS.Accent, 0, 2)
				hook(function() st.Color = COLORS.Accent end)
				return k
			end
			local k1, k2 = knob(), knob()
			local hit = make("TextButton", {AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5),
				Size = UDim2.new(1, 0, 0, COMPACT and 40 or 24), Text = "", ZIndex = 8}, track)
			local function snap(n)
				local sn = minV + math.floor(((n - minV) / inc) + 0.5) * inc
				return tonumber(string.format("%.10g", math.clamp(sn, minV, maxV)))
			end
			local function visual()
				local r1, r2 = (lo - minV) / (maxV - minV), (hi - minV) / (maxV - minV)
				fill.Position, fill.Size = UDim2.new(r1, 0, 0, 0), UDim2.new(r2 - r1, 0, 1, 0)
				k1.Position, k2.Position = UDim2.new(r1, 0, 0.5, 0), UDim2.new(r2, 0, 0.5, 0)
				vl.Text = tostring(lo) .. " - " .. tostring(hi) .. (config.Suffix or "")
			end
			local function set(l, h2, silent)
				l, h2 = snap(l), snap(h2)
				if l > h2 then l, h2 = h2, l end
				lo, hi = l, h2
				visual()
				if not silent then emit(config, {lo, hi}) end
			end
			local active
			hit.InputBegan:Connect(function(i)
				if not isPress(i) then return end
				active = nil
				local function drag(p)
					local w = track.AbsoluteSize.X
					if w <= 0 then return end
					local v = snap(minV + math.clamp((p.X - track.AbsolutePosition.X) / w, 0, 1) * (maxV - minV))
					if not active then active = math.abs(v - lo) <= math.abs(v - hi) and 1 or 2 end
					local pl, ph = lo, hi
					if active == 1 then lo = math.min(v, hi) else hi = math.max(v, lo) end
					if lo ~= pl or hi ~= ph then visual() emit(config, {lo, hi}) end
				end
				win.ActiveDrag = {Drag = drag}
				drag(pointer(i))
			end)
			visual()
			register(config, "range", function() return {lo, hi} end, function(v) if type(v) == "table" and v[1] and v[2] then set(v[1], v[2], false) end end)
			return common(row, lab, info, {Set = function(t, silent) if type(t) == "table" then set(t[1], t[2], silent) end end, Get = function() return {lo, hi} end}, config)
		end

