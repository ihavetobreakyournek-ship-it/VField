			win:Notify({Title = "Config", Content = ok and ("Saved '" .. name .. "'.") or "Could not save.", Kind = ok and "success" or "error"})
		end})
		cfgSec:CreateButton({Name = "Load Config", ButtonText = "LOAD", Callback = function()
			local ok = win:LoadConfig(name)
			win:Notify({Title = "Config", Content = ok and ("Loaded '" .. name .. "'.") or "No such config.", Kind = ok and "success" or "warn"})
		end})
		cfgSec:CreateButton({Name = "Delete Config", ButtonText = "DELETE", Confirm = true, Callback = function()
			local ok = win:DeleteConfig(name)
			dd.Refresh(win:ListConfigs())
			win:Notify({Title = "Config", Content = ok and ("Deleted '" .. name .. "'.") or "Nothing deleted.", Kind = ok and "success" or "warn"})
		end})
		cfgSec:CreateButton({Name = "Set As Auto-Load", Description = "Loads this config every time the script runs", ButtonText = "SET", Callback = function()
			local ok = win:SetAutoLoad(name)
			win:Notify({Title = "Config", Content = ok and ("'" .. name .. "' will auto-load.") or "Could not write.", Kind = ok and "success" or "error"})
		end})
		cfgSec:CreateButton({Name = "Export To Clipboard", ButtonText = "COPY", Callback = function()
			local ok = pcall(function() setclipboard(win:ExportConfig()) end)
			win:Notify({Title = "Config", Content = ok and "Copied to clipboard." or "Clipboard unsupported.", Kind = ok and "success" or "warn"})
		end})
		cfgSec:CreateInput({Name = "Import Config", Description = "Paste exported config text, then press Enter", PlaceholderText = "Paste JSON", IgnoreConfig = true, ClearAfter = true,
			Callback = function(t, enter)
				if not enter or t == "" then return end
				local ok = win:ImportConfig(t)
				win:Notify({Title = "Config", Content = ok and "Imported." or "Invalid config text.", Kind = ok and "success" or "error"})
			end})
		if o.Utilities ~= false then
			local ut = tab:CreateSection("UTILITIES")
			local afk = true
			conn(lp.Idled:Connect(function()
				if not afk then return end
				pcall(function()
					local vu = game:GetService("VirtualUser")
					vu:CaptureController()
					vu:ClickButton2(Vector2.new())
				end)
			end))
			ut:CreateToggle({Name = "Anti-AFK", Description = "Stops Roblox from kicking you for idling", CurrentValue = true, Flag = "vf_antiafk", Callback = function(v) afk = v end})
			ut:CreateButton({Name = "Rejoin Server", ButtonText = "REJOIN", Confirm = true, Callback = function()
				pcall(function()
					local TS = game:GetService("TeleportService")
					if #Players:GetPlayers() <= 1 then TS:Teleport(game.PlaceId, lp) else TS:TeleportToPlaceInstance(game.PlaceId, game.JobId, lp) end
				end)
			end})
			ut:CreateButton({Name = "Copy Job ID", ButtonText = "COPY", Callback = function() pcall(function() setclipboard(game.JobId) end) win:Notify({Title = "Copied", Content = "Job ID copied.", Kind = "success"}) end})
			ut:CreateButton({Name = "Copy Place ID", ButtonText = "COPY", Callback = function() pcall(function() setclipboard(tostring(game.PlaceId)) end) win:Notify({Title = "Copied", Content = "Place ID copied.", Kind = "success"}) end})
		end
		local about = tab:CreateSection("ABOUT")
		about:CreateLabel({Title = (cfg.Name or "V Field") .. " • V Field Library v" .. VField.Version,
			Content = "Right-click (PC) a bindable switch to set its key. Search finds any option. Tap a section title to collapse it. Drag the window edge corner to resize."})
		about:CreateButton({Name = "Unload", Description = "Removes the menu and everything it created", ButtonText = "UNLOAD", Confirm = true, Callback = function() VField:Unload() end})
		return tab
	end

	---------------------------------------------------------------
	-- loader
	---------------------------------------------------------------
	function win:Destroy()
		if self.Destroyed then return end
		self.Destroyed, dead, rainbowOn = true, true, false
		for _, fn in ipairs(self.DestroyFns) do pcall(fn) end
		for _, c in ipairs(self.Conns) do pcall(function() c:Disconnect() end) end
		pcall(function() tween(blur, 0.2, {Size = 0}) task.delay(0.25, function() blur:Destroy() end) end)
		screen:Destroy()
		if VField.Window == self then VField.Window = nil end
	end
	VField.Window = win

	task.spawn(function()
		if cfg.LoadingScreen == false then
			win.Toggle(true)
			return
		end
		local steps = cfg.LoadingSteps or {{"Initializing core", 0.25}, {"Building interface", 0.55}, {"Applying settings", 0.85}, {"Finalizing", 1}}
		local veil = make("Frame", {BackgroundColor3 = COLORS.Background, BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true, Size = UDim2.fromScale(1, 1), ZIndex = 30}, screen)
		tween(veil, 0.35, {BackgroundTransparency = 0.05})
		for _ = 1, 16 do
			task.spawn(function()
				local s = math.random(3, 6)
				local p = make("Frame", {BackgroundColor3 = COLORS.Bright, BorderSizePixel = 0, BackgroundTransparency = 1, Size = UDim2.fromOffset(s, s), Position = UDim2.fromScale(0.5, 1.05), ZIndex = 30}, veil)
				task.wait(math.random() * 2.5)
				while p.Parent and not win.Destroyed do
					local x, dur = math.random(), math.random(45, 90) / 10
					p.Position = UDim2.fromScale(x, 1.05)
					p.BackgroundTransparency = 0.75
					tween(p, dur, {Position = UDim2.fromScale(x + (math.random() - 0.5) * 0.1, -0.05), BackgroundTransparency = 1}, Enum.EasingStyle.Linear)
					task.wait(dur)
				end
			end)
		end
		local card = make("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = COLORS.Panel, BackgroundTransparency = 1, BorderSizePixel = 0,
			Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(300, 170), ZIndex = 31}, veil)
		local cStroke = stroke(card, COLORS.Accent, 0.35, 1)
		local cGrad = make("UIGradient", {Color = ColorSequence.new({ColorSequenceKeypoint.new(0, rgb(70, 70, 70)), ColorSequenceKeypoint.new(0.5, COLORS.Bright), ColorSequenceKeypoint.new(1, rgb(70, 70, 70))})}, cStroke)
		loop(cGrad, 3, {Rotation = 360})
		tween(card, 0.5, {Size = UDim2.fromOffset(340, 186), BackgroundTransparency = 0}, Enum.EasingStyle.Back)
		local title = T(card, "", 22, COLORS.Text, FONT_HEAVY, UDim2.new(0, 0, 0, 24), UDim2.new(1, 0, 0, 30))
		title.TextXAlignment, title.ZIndex = Enum.TextXAlignment.Center, 32
		local lsub = T(card, cfg.LoadingSubtitle or cfg.Subtitle or "Preparing your interface", 11, COLORS.Muted, FONT, UDim2.new(0, 0, 0, 58), UDim2.new(1, 0, 0, 16))
		lsub.TextXAlignment, lsub.ZIndex = Enum.TextXAlignment.Center, 32
		local sq = make("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0, 98), Size = UDim2.fromOffset(26, 26), ZIndex = 32}, card)
		local sqs = stroke(sq, COLORS.Bright, 0.2, 2)
		loop(sq, 2.4, {Rotation = 360})
		loop(sqs, 0.9, {Transparency = 0.8}, Enum.EasingStyle.Sine, true)
		local track = make("Frame", {BackgroundColor3 = COLORS.Raised, BorderSizePixel = 0, Position = UDim2.fromOffset(24, 130), Size = UDim2.new(1, -48, 0, 5), ZIndex = 32}, card)
		local fill = make("Frame", {BackgroundColor3 = COLORS.Bright, BorderSizePixel = 0, Size = UDim2.new(0.03, 0, 1, 0), ZIndex = 33}, track)
		local stage = T(card, "STARTING", 9, COLORS.Muted, FONT_BOLD, UDim2.fromOffset(24, 142), UDim2.new(1, -90, 0, 16))
		stage.ZIndex = 32
		local pct = T(card, "0%", 9, COLORS.Bright, FONT_BOLD, UDim2.new(1, -66, 0, 142), UDim2.fromOffset(42, 16))
		pct.ZIndex, pct.TextXAlignment = 32, Enum.TextXAlignment.Right
		playSound("Open", 0.8, 1.2)
		local word = cfg.LoadingTitle or string.upper(cfg.Name or "V FIELD")
		for i = 1, #word do
			if win.Destroyed then return end
			title.Text = word:sub(1, i)
			playSound("Tick", 0.5, 1.4 + i * 0.05)
			task.wait(0.04)
		end
		local prog = 0
		local function setProg(x) prog = x fill.Size = UDim2.new(math.max(x, 0.03), 0, 1, 0) pct.Text = ("%d%%"):format(math.floor(x * 100)) end
		for si, step in ipairs(steps) do
			if win.Destroyed then return end
			stage.Text = string.upper(step[1])
			playSound("Tick", 0.9, 0.9 + si * 0.1)
			local from, to, dur, t0 = prog, step[2], 0.25 + math.random() * 0.2, os.clock()
			while not win.Destroyed do
				local a = math.clamp((os.clock() - t0) / dur, 0, 1)
				setProg(from + (to - from) * (1 - (1 - a) ^ 3))
				if a >= 1 then break end
				task.wait()
			end
			if si == #steps - 1 then
				local w0 = os.clock()
				while not win.IsReady and os.clock() - w0 < 3 and not win.Destroyed do task.wait(0.05) end
			end
		end
		if win.Destroyed then return end
		stage.Text, stage.TextColor3 = "READY", COLORS.Bright
		playSound("Success", 1, 1.0)
		task.wait(0.35)
		tween(veil, 0.4, {BackgroundTransparency = 1})
		tween(card, 0.3, {Size = UDim2.fromOffset(370, 0), BackgroundTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		for _, d in ipairs(card:GetDescendants()) do
			if d:IsA("TextLabel") then tween(d, 0.25, {TextTransparency = 1})
			elseif d:IsA("Frame") then tween(d, 0.25, {BackgroundTransparency = 1})
			elseif d:IsA("UIStroke") then tween(d, 0.25, {Transparency = 1}) end
		end
		task.wait(0.4)
		if veil.Parent then veil:Destroy() end
		if not win.Destroyed then win.Toggle(true) end
	end)

	return win
end

function VField:Unload()
	dead, rainbowOn = true, false
	if VField.Window then pcall(function() VField.Window:Destroy() end) end
	local gp = getGuiParent()
	for _, c in ipairs({gp, getPlayerGui()}) do
		for _, n in ipairs({"VFieldUI", "VFieldKey"}) do
			local o = c:FindFirstChild(n)
			if o then o:Destroy() end
		end
	end
	env.VFieldLib = nil
end

VField.Destroy = VField.Unload

return VField
