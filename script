	local function emit(config, v)
		if config.Flag then win.Flags[config.Flag] = v end
		if win.AutoSave then win:QueueSave() end
		if config.Callback then task.spawn(config.Callback, v) end
	end
	local function register(config, kind, get, set)
		if not config.Flag then return end
		win.Registry[config.Flag] = {kind = kind, Get = get, Set = set, Ignore = config.IgnoreConfig}
		win.Flags[config.Flag] = get()
