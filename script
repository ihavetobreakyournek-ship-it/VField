	local function encode(kind, v)
		if kind == "color" then return {__c = {math.floor(v.R * 255 + 0.5), math.floor(v.G * 255 + 0.5), math.floor(v.B * 255 + 0.5)}} end
		if kind == "keybind" then return {__k = v and v.Name or false} end
		return v
	end
	local function decode(kind, v)
		if type(v) == "table" and v.__c then return Color3.fromRGB(v.__c[1], v.__c[2], v.__c[3]) end
		if type(v) == "table" and v.__k ~= nil then return v.__k or nil end
		return v
	end
	function win:ExportConfig()
		local t = {}
		for flag, r in pairs(self.Registry) do
			if not r.Ignore then
				local ok, val = pcall(r.Get)
				if ok then t[flag] = encode(r.kind, val) end
			end
		end
		return HttpService:JSONEncode(t)
	end
	function win:ImportConfig(json)
		local ok, t = pcall(function() return HttpService:JSONDecode(json) end)
		if not ok or type(t) ~= "table" then return false end
		for flag, val in pairs(t) do
			local r = self.Registry[flag]
			if r then pcall(r.Set, decode(r.kind, val)) end
		end
		return true
	end
	local function cfgPath(name)
		local clean = tostring(name):gsub("[^%w_%-]", "")
		return win.Folder .. "/configs/" .. clean .. ".json"
	end
	function win:SaveConfig(name)
		name = (name and name ~= "") and name or "default"
		return fsWrite(cfgPath(name), self:ExportConfig())
	end
	function win:LoadConfig(name)
		local d = fsRead(cfgPath((name and name ~= "") and name or "default"))
		return d ~= nil and self:ImportConfig(d)
	end
	function win:DeleteConfig(name)
		local p = cfgPath(name)
		if delfile and isfile and isfile(p) then return (pcall(delfile, p)) end
		return false
	end
	function win:ListConfigs()
		local out = {}
		if listfiles and isfolder and isfolder(self.Folder .. "/configs") then
			local ok, files = pcall(listfiles, self.Folder .. "/configs")
			if ok then
				for _, f in ipairs(files) do
					local n = f:match("([^/\\]+)%.json$")
					if n then out[#out + 1] = n end
				end
			end
		end
		table.sort(out)
		return out
	end
	function win:SetAutoLoad(name) return fsWrite(self.Folder .. "/autoload.txt", name or "") end
	function win:LoadAutoConfig(quiet)
		local name = fsRead(self.Folder .. "/autoload.txt")
		if name and name ~= "" then
			local ok = self:LoadConfig(name)
			if ok and not quiet then self:Notify({Title = "Config", Content = "Auto-loaded '" .. name .. "'.", Kind = "success"}) end
		elseif self.AutoSave then self:LoadConfig(self.CfgFileName or "autosave") end
	end
	local saveQueued = false
	function win:QueueSave()
		if saveQueued or not canFS then return end
		saveQueued = true
		task.delay(1.2, function() saveQueued = false if not win.Destroyed then win:SaveConfig(win.CfgFileName or "autosave") end end)
	end

