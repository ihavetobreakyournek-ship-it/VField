			hover(sel)
			local st = T(sel, "", 10 + BOOST * 2, "Text", FONT_BOLD, UDim2.fromOffset(10, 0), UDim2.new(1, -20, 1, 0))
			st.ZIndex, st.TextTruncate = 6, Enum.TextTruncate.AtEnd
			local OPT_H = COMPACT and 34 or 26
			local searchable = config.Searchable ~= false and #options > 7
			local SB = searchable and (OPT_H + 4) or 0
