local WINDOW_W, WINDOW_H, SIDEBAR_W, HEADER_H, PAD, ROW_W, NOTIF_W, SEARCH_H = 620, 420, 160, 60, 18, 0, 300, 36

local function computeLayout(cfg)
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	COMPACT = (UIS.TouchEnabled and not UIS.KeyboardEnabled) or vp.X < 700
	if COMPACT then
		BOOST = 1
		WINDOW_W, WINDOW_H = math.clamp(vp.X - 16, 290, 560), math.clamp(vp.Y - 36, 250, 440)
		SIDEBAR_W, HEADER_H, PAD, SEARCH_H = 58, 50, 10, 40
		NOTIF_W = math.clamp(vp.X - 28, 220, 300)
	else
		BOOST = 0
		local sz = cfg and typeof(cfg.Size) == "Vector2" and cfg.Size or Vector2.new(620, 420)
		WINDOW_W, WINDOW_H = sz.X, sz.Y
		SIDEBAR_W, HEADER_H, PAD, NOTIF_W, SEARCH_H = 160, 60, 18, 300, 36
	end
	ROW_W = WINDOW_W - SIDEBAR_W - PAD * 2
end

