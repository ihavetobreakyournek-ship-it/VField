local function runKeySystem(cfg)
	local ks = cfg.KeySystem
	local folder = cfg.ConfigFolder or "VField"
	local path = folder .. "/" .. (ks.FileName or "key") .. ".txt"
	local remote, fetched = nil, false
	local function norm(s)
		s = tostring(s or "")
		s = s:gsub("^%s+", "")
		s = s:gsub("%s+$", "")
		return s
	end
	local function fetchRemote()
		if fetched or not ks.KeyUrl then return end
		fetched = true
		local ok, body = pcall(function() return game:HttpGet(ks.KeyUrl) end)
		if ok and type(body) == "string" then
			remote = {}
			for line in body:gmatch("[^\r\n]+") do remote[#remote + 1] = norm(line) end
		end
	end
	local function check(key)
		key = norm(key)
		if key == "" then return false, "Enter a key first." end
		if ks.Expires and os.time() >= ks.Expires then return false, "This key system has expired." end
		if ks.Validate then
			local ok, res, msg = pcall(ks.Validate, key)
			if ok and res == true then return true end
			return false, (ok and msg) or nil
		end
		local keys = {}
		if type(ks.Key) == "string" then keys[1] = ks.Key end
		for _, k in ipairs(ks.Keys or {}) do keys[#keys + 1] = k end
		for _, k in ipairs(remote or {}) do keys[#keys + 1] = k end
		for _, k in ipairs(keys) do
			local a, b = norm(k), key
			if ks.CaseSensitive == false then a, b = a:lower(), b:lower() end
			if a == b then return true end
		end
		return false
	end

	fetchRemote()
	if ks.SaveKey ~= false then
		local saved = fsRead(path)
		if saved and (check(saved)) then return true end
	end

	local screen = newScreen("VFieldKey")
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local veil = make("Frame", {BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1)}, screen)
	tween(veil, 0.3, {BackgroundTransparency = 0.45})
	local cw = math.clamp(vp.X - 24, 260, 400)
	local card = make("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(cw, 260),
		BackgroundColor3 = COLORS.Background, BorderSizePixel = 0}, veil)
	stroke(card, COLORS.Accent, 0.4, 1)
	make("Frame", {BackgroundColor3 = COLORS.Accent, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 3)}, card)
	T(card, ks.Title or ((cfg.Name or "V Field") .. " • Key System"), 17, COLORS.Text, FONT_HEAVY, UDim2.fromOffset(20, 16), UDim2.new(1, -60, 0, 24))
	T(card, ks.Subtitle or "Enter your key to continue", 11, COLORS.Muted, FONT, UDim2.fromOffset(20, 40), UDim2.new(1, -40, 0, 16))
	local note = T(card, ks.Note or "", 10, COLORS.Muted, FONT, UDim2.fromOffset(20, 62), UDim2.new(1, -40, 0, 36))
	note.TextWrapped, note.TextYAlignment = true, Enum.TextYAlignment.Top
	local x = B(card, "×", UDim2.new(1, -38, 0, 12), UDim2.fromOffset(26, 26))
	x.BackgroundColor3, x.TextColor3, x.TextSize = COLORS.Raised, COLORS.Muted, 18
	local box = make("TextBox", {BackgroundColor3 = COLORS.Raised, BorderSizePixel = 0, ClearTextOnFocus = false, Font = FONT, PlaceholderText = "Paste your key here...",
		PlaceholderColor3 = COLORS.Muted, Text = "", TextColor3 = COLORS.Text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(20, 106), Size = UDim2.new(1, -40, 0, 38)}, card)
	make("UIPadding", {PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}, box)
	local bs = stroke(box, COLORS.Line, 0.2, 1)
	box.Focused:Connect(function() tween(bs, 0.15, {Color = COLORS.Accent}) end)
	box.FocusLost:Connect(function() tween(bs, 0.2, {Color = COLORS.Line}) end)
	local status = T(card, "", 11, COLORS.Muted, FONT, UDim2.fromOffset(20, 152), UDim2.new(1, -40, 0, 18))
	local hasLink = type(ks.Link) == "string" and ks.Link ~= ""
	local bw = hasLink and (cw - 48) / 2 or cw - 40
	local submitBtn = B(card, "SUBMIT", UDim2.fromOffset(20, 180), UDim2.fromOffset(bw, 38))
	submitBtn.BackgroundColor3 = COLORS.Accent
	submitBtn.TextColor3 = COLORS.Background
	if hasLink then
		local linkBtn = B(card, "GET KEY", UDim2.fromOffset(28 + bw, 180), UDim2.fromOffset(bw, 38))
		linkBtn.MouseButton1Click:Connect(function()
			playSound("Click")
			local ok = pcall(function() setclipboard(ks.Link) end)
			status.TextColor3 = ok and STATUS.success or STATUS.warn
			status.Text = ok and "Key link copied to your clipboard." or ("Get your key at: " .. ks.Link)
		end)
	end
	local foot = T(card, "", 9, COLORS.Muted, FONT, UDim2.fromOffset(20, 230), UDim2.new(1, -40, 0, 14))
	foot.TextXAlignment = Enum.TextXAlignment.Center
	local attempts, busy, done, result = 0, false, false, false
	local max = ks.MaxAttempts
	if max then foot.Text = ("Attempts left: %d"):format(max) end
	local function finish(ok)
		if done then return end
		done, result = true, ok
		tween(veil, 0.25, {BackgroundTransparency = 1})
		tween(card, 0.25, {Size = UDim2.fromOffset(cw, 0)})
		task.delay(0.3, function() screen:Destroy() end)
	end
	local function submit()
		if busy or done then return end
		busy = true
		status.TextColor3, status.Text = COLORS.Muted, "Checking key..."
		task.spawn(function()
			fetchRemote()
			local ok, msg = check(box.Text)
			if ok then
				playSound("Success")
				status.TextColor3, status.Text = STATUS.success, "Key accepted!"
				if ks.SaveKey ~= false then fsWrite(path, norm(box.Text)) end
				task.wait(0.45)
				finish(true)
			else
				attempts += 1
				playSound("Error")
				status.TextColor3 = STATUS.error
				status.Text = msg or "Invalid key."
				if max then foot.Text = ("Attempts left: %d"):format(math.max(max - attempts, 0)) end
				for i = 1, 4 do
					tween(card, 0.04, {Position = UDim2.new(0.5, i % 2 == 0 and 8 or -8, 0.5, 0)})
					task.wait(0.04)
				end
				tween(card, 0.06, {Position = UDim2.fromScale(0.5, 0.5)})
				if max and attempts >= max then
					task.wait(0.4)
					finish(false)
					if ks.KickOnFail then lp:Kick(ks.KickMessage or "Too many invalid key attempts.") end
				end
				busy = false
			end
		end)
	end
	submitBtn.MouseButton1Click:Connect(function() playSound("Click") submit() end)
	box.FocusLost:Connect(function(enter) if enter then submit() end end)
	x.MouseButton1Click:Connect(function() finish(false) end)
	repeat task.wait(0.1) until done
	return result
end

