local ELEMENT_NAMES = {"CreateLabel", "CreateParagraph", "CreateDivider", "CreateButton", "CreateToggle", "CreateSlider", "CreateRangeSlider",
	"CreateProgressBar", "CreateDropdown", "CreateInput", "CreateKeybind", "CreateColorPicker", "CreateSegmented", "CreateConsole", "CreateImage", "CreateLink"}

local function normalizeWindowCfg(src)
	local c = {}
	for k, v in pairs(src) do c[k] = v end
	if c.ToggleUIKeybind and not c.ToggleKey then
		local k = c.ToggleUIKeybind
		if typeof(k) == "string" then local ok, kk = pcall(function() return Enum.KeyCode[k] end) k = ok and kk or nil end
		c.ToggleKey = k
	end
	local cs = c.ConfigurationSaving
	if type(cs) == "table" and cs.Enabled then
		c.ConfigFolder = c.ConfigFolder or cs.FolderName or "VField"
		c.AutoSave = true
		c.CfgFileName = cs.FileName
	end
	local ksr = src.KeySettings
	if src.KeySystem == true and type(ksr) == "table" then
		local kk = ksr.Key
		local ks = {Enabled = true, Title = ksr.Title, Subtitle = ksr.Subtitle, Note = ksr.Note, FileName = ksr.FileName, SaveKey = ksr.SaveKey}
		if ksr.GrabKeyFromSite and type(kk) == "table" and kk[1] then ks.KeyUrl = kk[1]
		else ks.Keys = type(kk) == "table" and kk or {tostring(kk or "")} end
		c.KeySystem = ks
	elseif type(src.KeySystem) ~= "table" then
		c.KeySystem = nil
	end
	return c
end

function VField:CreateWindow(cfg)
	cfg = normalizeWindowCfg(cfg or {})
	dead, hooks = false, {}
	if cfg.Theme == "Rainbow" then VField:SetRainbow(true)
	elseif cfg.Theme and THEMES[ALIAS[cfg.Theme] or cfg.Theme] then
		currentTheme = ALIAS[cfg.Theme] or cfg.Theme
		for k, v in pairs(THEMES[currentTheme]) do COLORS[k] = v end
	end
	if cfg.KeySystem and cfg.KeySystem.Enabled ~= false then
		if not runKeySystem(cfg) then return nil end
		if cfg.KeySystem.OnSuccess then pcall(cfg.KeySystem.OnSuccess) end
	end
	computeLayout(cfg)
	local screen = newScreen("VFieldUI")
	local win = {Tabs = {}, Conns = {}, Keybinds = {}, Binds = {}, Registry = {}, Flags = {}, Destroyed = false, NotifIndex = 0,
		Ready = false, Open = false, ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightControl, BlurOn = cfg.Blur ~= false,
		AutoSave = cfg.AutoSave == true, Folder = (cfg.ConfigFolder or "VField") .. (cfg.PerGame and ("/" .. tostring(game.PlaceId)) or ""),
		CfgFileName = cfg.CfgFileName, ToggleFns = {}, TabOrder = 0, CurScale = 1, NotifyOn = true, DestroyFns = {}}
	win.Flags = VField.Flags
	for k in pairs(VField.Flags) do VField.Flags[k] = nil end
	local function conn(c) win.Conns[#win.Conns + 1] = c return c end
	function win:Ready() self.IsReady = true if cfg.AutoLoad ~= false then task.defer(function() self:LoadAutoConfig(true) end) end end
	function win:OnDestroy(fn) self.DestroyFns[#self.DestroyFns + 1] = fn end

	local blur = Lighting:FindFirstChild("VFieldBlur") or make("BlurEffect", {Name = "VFieldBlur", Size = 0}, Lighting)
	local function applyBlur(show) tween(blur, 0.3, {Size = (show and win.BlurOn) and 8 or 0}) end

	local W, H = WINDOW_W, WINDOW_H
	local baseT = 0
	local vp0 = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	local main = P(make("Frame", {Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Position = UDim2.fromOffset(vp0.X / 2, vp0.Y / 2),
		Size = UDim2.fromOffset(W, H), Visible = false, ZIndex = 10}, screen), {BackgroundColor3 = "Background"})
	local mainStroke = stroke(main, COLORS.Accent, 0.5, 1)
	hook(function() mainStroke.Color = COLORS.Accent end)
	local mainScale = make("UIScale", {Scale = 1}, main)
	local respScale, userScale = 1, 1
	local function updateScale()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local vp = cam.ViewportSize
		local fit = math.min((vp.X - 24) / (W + 20), (vp.Y - 60) / (H + 20))
		respScale = math.clamp(math.min(1, fit) * userScale, 0.35, 2)
		mainScale.Scale = respScale
		win.CurScale = respScale
	end
	updateScale()
	if workspace.CurrentCamera then conn(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)) end
	function win:SetScale(m) userScale = m updateScale() end
	function win:SetBlur(on) self.BlurOn = on applyBlur(self.Open) end
	function win:SetSounds(on) snd.on = on end
	function win:SetVolume(v) snd.vol = v end
	function win:SetTransparency(a) baseT = math.clamp(a, 0, 0.8) if self.Open then tween(main, 0.2, {BackgroundTransparency = baseT}) end end
	function win:SetNotifications(on) self.NotifyOn = on end
	function win:SetToggleKey(k) self.ToggleKey = k end
	function win:OnToggle(fn) self.ToggleFns[#self.ToggleFns + 1] = fn end
	function win:ResetPosition()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		tween(main, 0.3, {Position = UDim2.fromOffset(vp.X / 2, vp.Y / 2)})
	end

	local lastPointer = Vector2.new()
	local function remember(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then lastPointer = pointer(input) end
	end
	conn(UIS.InputBegan:Connect(remember))
	conn(UIS.InputChanged:Connect(remember))

	local function ripple(parent)
		if win.Destroyed or not parent.Parent then return end
		local ap, as = parent.AbsolutePosition, parent.AbsoluteSize
		if as.X <= 0 or as.Y <= 0 then return end
		local rx, ry = math.clamp((lastPointer.X - ap.X) / as.X, 0, 1), math.clamp((lastPointer.Y - ap.Y) / as.Y, 0, 1)
		local clip = make("Frame", {BackgroundTransparency = 1, ClipsDescendants = true, Size = UDim2.fromScale(1, 1), ZIndex = parent.ZIndex + 6}, parent)
		local wave = make("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = COLORS.Bright, BackgroundTransparency = 0.72, BorderSizePixel = 0,
			Position = UDim2.fromScale(rx, ry), Size = UDim2.fromOffset(2, 2), ZIndex = parent.ZIndex + 6}, clip)
		tween(wave, 0.45, {Size = UDim2.fromOffset(as.X * 2.4, as.X * 2.4), BackgroundTransparency = 1})
		task.delay(0.5, function() if clip.Parent then clip:Destroy() end end)
	end
	local lastHover = 0
	local function hover(btn)
		btn.MouseEnter:Connect(function()
			if win.Destroyed or os.clock() - lastHover < 0.06 then return end
			lastHover = os.clock()
			playSound("Hover")
		end)
	end

	-- tooltip
	local tip = P(make("Frame", {BorderSizePixel = 0, Visible = false, ZIndex = 400, AutomaticSize = Enum.AutomaticSize.XY}, screen), {BackgroundColor3 = "Panel"})
	local tipStroke = stroke(tip, COLORS.Accent, 0.3, 1)
	hook(function() tipStroke.Color = COLORS.Accent end)
	make("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5)}, tip)
	local tipText = T(tip, "", 10, "Text", FONT, UDim2.new(), UDim2.fromOffset(0, 0))
	tipText.AutomaticSize, tipText.ZIndex, tipText.TextWrapped = Enum.AutomaticSize.XY, 401, false
	local tipTok = 0
	local function attachTip(gui, text)
		if not text or text == "" then return end
		gui.MouseEnter:Connect(function()
			tipTok += 1
			local my = tipTok
			task.delay(0.45, function()
				if tipTok ~= my or win.Destroyed then return end
				tipText.Text = text
				tip.Position = UDim2.fromOffset(lastPointer.X + 14, lastPointer.Y + 18)
				tip.Visible = true
			end)
		end)
		gui.MouseLeave:Connect(function() tipTok += 1 tip.Visible = false end)
	end

	-- header
	local header = P(make("Frame", {BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, HEADER_H), ZIndex = 2}, main), {BackgroundColor3 = "Panel"})
	local logo = make("Frame", {BorderSizePixel = 0, Position = UDim2.fromOffset(COMPACT and 10 or 16, (HEADER_H - 34) / 2), Size = UDim2.fromOffset(34, 34), ZIndex = 3,
		BackgroundColor3 = Color3.new(0, 0, 0)}, header)
	local logoStroke = stroke(logo, COLORS.Bright, 0.35, 1)
	hook(function() logoStroke.Color = COLORS.Bright end)
	loop(logoStroke, 1.2, {Transparency = 0.05, Thickness = 1.6}, Enum.EasingStyle.Sine, true)
	local logoIcon = tostring(cfg.Icon or "")
	local logoImg = logoIcon:match("^rbxassetid://") and logoIcon or (logoIcon:match("^%d+$") and ("rbxassetid://" .. logoIcon) or nil)
	if logoImg then
		local li = make("ImageLabel", {BackgroundTransparency = 1, Image = logoImg, Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6), ZIndex = 4}, logo)
		P(li, {ImageColor3 = "Bright"})
	else
		local lt = T(logo, logoIcon ~= "" and logoIcon or string.upper(string.sub(cfg.Name or "V", 1, 1)), 18, "Bright", FONT_HEAVY, UDim2.new(), UDim2.fromScale(1, 1))
		lt.TextXAlignment, lt.ZIndex = Enum.TextXAlignment.Center, 4
	end
	local tx = COMPACT and 52 or 60
	local titleLbl = T(header, cfg.Name or "V Field", 16, "Text", FONT_HEAVY, UDim2.fromOffset(tx, COMPACT and 6 or 10), UDim2.new(1, -(tx + 110), 0, 22))
	titleLbl.ZIndex = 3
	local sub = T(header, cfg.Subtitle or "", 10, "Muted", FONT, UDim2.fromOffset(tx, COMPACT and 27 or 33), UDim2.new(1, -(tx + 110), 0, 16))
	sub.ZIndex, sub.TextTruncate = 3, Enum.TextTruncate.AtEnd
	function win:SetTitle(t) titleLbl.Text = tostring(t) end
	function win:SetSubtitle(t) sub.Text = tostring(t) end
	local cs = COMPACT and 34 or 28
	local function headBtn(txt, off)
		local b = B(header, txt, UDim2.new(1, -(cs + 10) - off, 0, (HEADER_H - cs) / 2), UDim2.fromOffset(cs, cs))
		b.TextSize, b.ZIndex = 18, 3
		P(b, {TextColor3 = "Muted"})
		hover(b)
		b.MouseEnter:Connect(function() tween(b, 0.12, {BackgroundColor3 = COLORS.Hover, TextColor3 = COLORS.Bright}) end)
		b.MouseLeave:Connect(function() tween(b, 0.15, {BackgroundColor3 = COLORS.Raised, TextColor3 = COLORS.Muted}) end)
		return b
	end
	local closeBtn, minBtn = headBtn("×", 0), headBtn("–", cs + 6)
	local aline = make("Frame", {BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, HEADER_H - 2), Size = UDim2.new(1, 0, 0, 2), ZIndex = 3}, main)
	local ag = make("UIGradient", {Offset = Vector2.new(-1, 0)}, aline)
	hook(function() ag.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, COLORS.Soft), ColorSequenceKeypoint.new(0.5, COLORS.Bright), ColorSequenceKeypoint.new(1, COLORS.Soft)}) end)
	loop(ag, 2.4, {Offset = Vector2.new(1, 0)}, Enum.EasingStyle.Sine, false)

	local body = make("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(0, HEADER_H), Size = UDim2.new(1, 0, 1, -HEADER_H), ZIndex = 2, ClipsDescendants = true}, main)
	local sidebar = P(make("Frame", {BorderSizePixel = 0, Size = UDim2.new(0, SIDEBAR_W, 1, 0), ZIndex = 2}, body), {BackgroundColor3 = "Panel"})
	local userH = COMPACT and 0 or 44
	local tabList = make("ScrollingFrame", {BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 2, Position = UDim2.fromOffset(COMPACT and 6 or 10, 10), Size = UDim2.new(1, COMPACT and -12 or -20, 1, -(20 + userH)), ZIndex = 3}, sidebar)
	list(tabList, 6)
	if not COMPACT then
		local ub = make("Frame", {BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -userH), Size = UDim2.new(1, 0, 0, userH), ZIndex = 3}, sidebar)
		make("Frame", {BackgroundColor3 = COLORS.Line, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), ZIndex = 3}, ub)
		local av = make("ImageLabel", {BackgroundColor3 = COLORS.Raised, BorderSizePixel = 0, Position = UDim2.fromOffset(10, 8), Size = UDim2.fromOffset(28, 28), ZIndex = 4}, ub)
		task.spawn(function()
			local ok, img = pcall(function() return Players:GetUserThumbnailAsync(lp.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48) end)
			if ok and av.Parent then av.Image = img end
		end)
		local un = T(ub, lp.DisplayName, 11, "Text", FONT_BOLD, UDim2.fromOffset(46, 7), UDim2.new(1, -52, 0, 15))
		un.ZIndex, un.TextTruncate = 4, Enum.TextTruncate.AtEnd
		local us = T(ub, cfg.Footer or ("V Field v" .. VField.Version), 9, "Muted", FONT, UDim2.fromOffset(46, 22), UDim2.new(1, -52, 0, 12))
		us.ZIndex, us.TextTruncate = 4, Enum.TextTruncate.AtEnd
	end
	local content = make("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(SIDEBAR_W, 0), Size = UDim2.new(1, -SIDEBAR_W, 1, 0), ZIndex = 2}, body)

	-- search
	local searchWrap = make("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, SEARCH_H), ZIndex = 3}, content)
	local sBox = P(make("TextBox", {BorderSizePixel = 0, ClearTextOnFocus = false, Font = FONT, PlaceholderText = "Search options...", Text = "", TextSize = 11 + BOOST,
		TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(PAD, 7), Size = UDim2.new(1, -PAD * 2, 1, -9), ZIndex = 4}, searchWrap),
		{BackgroundColor3 = "Raised", TextColor3 = "Text", PlaceholderColor3 = "Muted"})
	local sStroke = stroke(sBox, COLORS.Line, 0.35, 1)
	make("UIPadding", {PaddingLeft = UDim.new(0, 28), PaddingRight = UDim.new(0, 8)}, sBox)
	local sIcon = T(sBox, "⌕", 15, "Muted", FONT_BOLD, UDim2.fromOffset(-22, 0), UDim2.fromOffset(18, SEARCH_H - 9))
	sIcon.ZIndex, sIcon.TextXAlignment = 5, Enum.TextXAlignment.Center
	sBox.Focused:Connect(function() tween(sStroke, 0.15, {Transparency = 0, Color = COLORS.Accent}) end)
	sBox.FocusLost:Connect(function() tween(sStroke, 0.2, {Transparency = 0.35, Color = COLORS.Line}) end)
	local pagesHolder = make("Frame", {BackgroundTransparency = 1, ClipsDescendants = true, Position = UDim2.fromOffset(0, SEARCH_H), Size = UDim2.new(1, 0, 1, -SEARCH_H), ZIndex = 2}, content)

	-- resize grip
	local grip = make("TextButton", {AutoButtonColor = false, BackgroundTransparency = 1, Text = "◢", TextSize = 14, Font = FONT_BOLD, Size = UDim2.fromOffset(20, 20),
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -1, 1, -1), ZIndex = 60}, main)
	P(grip, {TextColor3 = "Muted"})

	-- reveal button (shown while the window is hidden; draggable)
	local revW = 176
	local reveal = make("TextButton", {Active = true, AutoButtonColor = false, BorderSizePixel = 0, ClipsDescendants = true, Size = UDim2.fromOffset(revW, 38), Text = "", Visible = false,
		ZIndex = 100, Position = UDim2.fromOffset(math.max(10, (vp0.X - revW) / 2), 16)}, screen)
	P(reveal, {BackgroundColor3 = "Background"})
	local revStroke = stroke(reveal, COLORS.Accent, 0.22, 1.2)
	hook(function() revStroke.Color = COLORS.Accent end)
	loop(revStroke, 1.1, {Transparency = 0.04, Thickness = 1.8}, Enum.EasingStyle.Sine, true)
	local rb = make("Frame", {BorderSizePixel = 0, Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(18, 18), ZIndex = 102}, reveal)
	P(rb, {BackgroundColor3 = "Bright"})
	T(reveal, "SHOW " .. string.upper(cfg.Name or "V FIELD"), 10, "Text", FONT_HEAVY, UDim2.fromOffset(38, 0), UDim2.new(1, -44, 1, 0)).ZIndex = 102
	hover(reveal)

	local token = 0
	function win.Toggle(force)
		if win.Destroyed then return end
		local show = force
		if show == nil then show = not win.Open end
		if show == win.Open then return end
		win.Open = show
		for _, f in ipairs(win.ToggleFns) do task.spawn(f, show) end
		token += 1
		local my = token
		if show then
			playSound("Open")
			main.Visible, reveal.Visible = true, false
			mainScale.Scale = respScale * 0.92
			main.BackgroundTransparency = 0.4
			tween(mainScale, 0.35, {Scale = respScale}, Enum.EasingStyle.Back)
			tween(main, 0.25, {BackgroundTransparency = baseT})
			applyBlur(true)
		else
			playSound("Close")
			tween(mainScale, 0.2, {Scale = respScale * 0.94}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tween(main, 0.18, {BackgroundTransparency = 0.4}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			applyBlur(false)
			task.delay(0.2, function()
				if not win.Destroyed and token == my then
					main.Visible, reveal.Visible = false, true
					reveal.BackgroundTransparency = 0.4
					tween(reveal, 0.3, {BackgroundTransparency = 0}, Enum.EasingStyle.Back)
				end
			end)
		end
	end
	closeBtn.MouseButton1Click:Connect(function() playSound("Click") win.Toggle(false) end)
	local minimized = false
	minBtn.MouseButton1Click:Connect(function()
		playSound("Click")
		minimized = not minimized
		grip.Visible = not minimized
		if minimized then
			body.Visible = false
			tween(main, 0.22, {Size = UDim2.fromOffset(W, HEADER_H)})
		else
			tween(main, 0.22, {Size = UDim2.fromOffset(W, H)})
			task.delay(0.1, function() if not minimized then body.Visible = true end end)
		end
	end)

	-- dragging: window, reveal button, resize grip, sliders, pickers, huds (one shared drag slot)
	header.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		local p = pointer(input)
		if inside(closeBtn, p) or inside(minBtn, p) then return end
		local sp, so = p, Vector2.new(main.Position.X.Offset, main.Position.Y.Offset)
		tween(mainStroke, 0.15, {Transparency = 0.15})
		win.ActiveDrag = {
			Drag = function(q)
				local cam = workspace.CurrentCamera
				local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
				local hw, hh = main.AbsoluteSize.X / 2, main.AbsoluteSize.Y / 2
				local n = so + (q - sp)
				main.Position = UDim2.fromOffset(math.clamp(n.X, hw, math.max(vp.X - hw, hw)), math.clamp(n.Y, hh, math.max(vp.Y - hh, hh)))
			end,
			Release = function() tween(mainStroke, 0.25, {Transparency = 0.5}) end,
		}
	end)
	grip.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		local sp, sw, sh, so = pointer(input), W, H, Vector2.new(main.Position.X.Offset, main.Position.Y.Offset)
		win.ActiveDrag = {Drag = function(q)
			local cam = workspace.CurrentCamera
			local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
			local sc = math.max(win.CurScale, 0.01)
			local d = (q - sp) / sc
			local minW, minH = COMPACT and 280 or 480, 280
			local nw = math.clamp(sw + d.X, minW, math.max(minW, vp.X / sc - 20))
			local nh = math.clamp(sh + d.Y, minH, math.max(minH, vp.Y / sc - 20))
			W, H = nw, nh
			main.Size = UDim2.fromOffset(nw, nh)
			main.Position = UDim2.fromOffset(so.X + (nw - sw) * sc / 2, so.Y + (nh - sh) * sc / 2)
		end}
	end)
	local rdrag
	reveal.InputBegan:Connect(function(input)
		if isPress(input) then rdrag = {t = input.UserInputType, sx = input.Position.X, sy = input.Position.Y, ox = reveal.Position.X.Offset, oy = reveal.Position.Y.Offset, moved = false} end
	end)
	conn(UIS.InputChanged:Connect(function(input)
		if win.Destroyed then return end
		local t = input.UserInputType
		if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then return end
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
		if rdrag then
			local dx, dy = input.Position.X - rdrag.sx, input.Position.Y - rdrag.sy
			if math.abs(dx) > 5 or math.abs(dy) > 5 then rdrag.moved = true end
			if rdrag.moved then reveal.Position = UDim2.fromOffset(math.clamp(rdrag.ox + dx, 5, vp.X - revW - 5), math.clamp(rdrag.oy + dy, 5, vp.Y - 45)) end
		end
		if win.ActiveDrag then win.ActiveDrag.Drag(pointer(input)) end
	end))
	conn(UIS.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			if win.ActiveDrag then local a = win.ActiveDrag win.ActiveDrag = nil if a.Release then a.Release() end end
		end
		if rdrag and t == rdrag.t then
			if not rdrag.moved and not win.Destroyed then playSound("Click") win.Toggle(true) end
			rdrag = nil
		end
		for _, b in ipairs(win.Keybinds) do
			local k = b.Value()
			if b.Release and k and input.KeyCode == k then task.spawn(b.Release, false) end
		end
	end))
	conn(UIS.InputBegan:Connect(function(input, processed)
		if win.Destroyed then return end
		if win.WaitingKey then
			if input.KeyCode ~= Enum.KeyCode.Unknown then
				local w = win.WaitingKey
				win.WaitingKey = nil
				w(input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode or nil)
			end
			return
		end
		if processed then return end
		if input.KeyCode == win.ToggleKey then win.Toggle() end
		for _, b in ipairs(win.Keybinds) do
			local k = b.Value()
			if b.Callback and k and input.KeyCode == k then task.spawn(b.Callback, true) end
		end
	end))

	---------------------------------------------------------------
	-- HUD widgets (draggable, positions saved in configs)
	---------------------------------------------------------------
	function win:CreateHud(id, size, pos, flagSave)
		local f = make("Frame", {Name = "Hud" .. id, Active = true, BackgroundTransparency = 0.12, BorderSizePixel = 0, Size = size, Position = pos, Visible = false, ZIndex = 5}, screen)
		P(f, {BackgroundColor3 = "Background"})
		local st = stroke(f, COLORS.Accent, 0.5, 1)
		hook(function() st.Color = COLORS.Accent end)
		f.InputBegan:Connect(function(i)
			if not isPress(i) then return end
			local sp, so = pointer(i), Vector2.new(f.Position.X.Offset, f.Position.Y.Offset)
			win.ActiveDrag = {Drag = function(p)
				local cam = workspace.CurrentCamera
				local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
				local n = so + (p - sp)
				f.Position = UDim2.fromOffset(math.clamp(n.X, 0, math.max(vp.X - f.AbsoluteSize.X, 0)), math.clamp(n.Y, 0, math.max(vp.Y - f.AbsoluteSize.Y, 0)))
			end, Release = function() if win.AutoSave then win:QueueSave() end end}
		end)
		if flagSave then
