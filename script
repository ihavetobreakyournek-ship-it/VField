		function section:CreateToggle(config)
			local sw, sh = COMPACT and 50 or 40, COMPACT and 26 or 20
			local row, lab, info = makeRow(self, config, sw + 24 + (config.Bindable and 56 or 0), 52)
			local switch = P(make("TextButton", {AutoButtonColor = false, BorderSizePixel = 0, ClipsDescendants = true, Text = "",
				Position = UDim2.new(1, -(sw + 14), 0, 0), Size = UDim2.fromOffset(sw, sh), ZIndex = 5}, row), {BackgroundColor3 = "Panel"})
			info.VC(switch)
			local sws = stroke(switch, COLORS.Line, 0.3, 1)
			local knob = make("Frame", {BorderSizePixel = 0, Position = UDim2.fromOffset(3, 3), Size = UDim2.fromOffset(sh - 6, sh - 6), ZIndex = 6}, switch)
			local enabled = config.CurrentValue == true
			local function colors(anim)
				local bgc = enabled and COLORS.Soft or COLORS.Panel
				local sc = enabled and COLORS.Bright or COLORS.Line
				local kc = enabled and COLORS.Bright or COLORS.Muted
				local st = enabled and 0.1 or 0.3
				if anim then
					tween(switch, 0.2, {BackgroundColor3 = bgc}) tween(sws, 0.2, {Color = sc, Transparency = st}) tween(knob, 0.2, {BackgroundColor3 = kc})
				else
					switch.BackgroundColor3, sws.Color, sws.Transparency, knob.BackgroundColor3 = bgc, sc, st, kc
				end
			end
			local function place(anim)
				local p = enabled and UDim2.fromOffset(sw - sh + 3, 3) or UDim2.fromOffset(3, 3)
				if anim then tween(knob, 0.22, {Position = p}, Enum.EasingStyle.Back) else knob.Position = p end
			end
			local function set(v, silent)
				enabled = v == true
				colors(true) place(true)
				if not silent then
					playSound(enabled and "ToggleOn" or "ToggleOff")
					ripple(switch)
					emit(config, enabled)
				end
			end
			colors(false) place(false)
			hook(function() colors(false) end)
			switch.MouseButton1Click:Connect(function() set(not enabled, false) end)
			hover(switch)
			local extra = {Set = set, Get = function() return enabled end}
			if config.Bindable then
				local bind = config.CurrentBind
				if typeof(bind) == "string" then local ok, k = pcall(function() return Enum.KeyCode[bind] end) bind = ok and k or nil end
				local chip = T(row, "", 9 + BOOST, "Muted", FONT_BOLD, UDim2.new(1, -(sw + 74), 0, 0), UDim2.fromOffset(56, 16))
				chip.ZIndex, chip.TextXAlignment = 5, Enum.TextXAlignment.Right
				info.VC(chip)
				local function showBind() chip.Text = bind and ("[" .. bind.Name .. "]") or "" end
				showBind()
				table.insert(win.Keybinds, {Value = function() return bind end, Callback = function() set(not enabled, false) end})
				table.insert(win.Binds, {Name = strip(config.Name), Key = function() return bind end, Active = function() return enabled end})
				local function setBind(k)
					if typeof(k) == "string" then local ok, kk = pcall(function() return Enum.KeyCode[k] end) k = ok and kk or nil end
					bind = k
					showBind()
				end
				switch.MouseButton2Click:Connect(function()
					playSound("Click")
					chip.Text = "[...]"
					win.WaitingKey = function(k) setBind(k) if config.OnBind then task.spawn(config.OnBind, k and k.Name or nil) end end
				end)
				if config.Flag then
					win.Registry[config.Flag .. "_bind"] = {kind = "keybind", Get = function() return bind end, Set = setBind}
				end
				extra.SetBind, extra.GetBind = setBind, function() return bind end
			end
			register(config, "toggle", function() return enabled end, function(v) set(v, false) end)
			return common(row, lab, info, extra, config)
		end

