				win:Notify({Title = config.Name or "Link", Content = ok and "Copied to clipboard." or tostring(config.Link or ""), Kind = ok and "success" or "info"})
				if cb then cb() end
			end
			return self:CreateButton(c)
		end

		local function normCfg(n, c)
			if type(c) == "string" then c = {Name = c, Title = c}
			elseif type(c) == "table" then local t = {} for k, v in pairs(c) do t[k] = v end c = t
			else c = {} end
			if n == "CreateColorPicker" and c.Color and not c.CurrentValue then c.CurrentValue = c.Color end
			if n == "CreateDropdown" then
				if c.MultipleOptions and c.Multi == nil then c.Multi = true end
				if type(c.CurrentOption) == "table" and not c.Multi then c.CompatTable = true c.CurrentOption = c.CurrentOption[1] end
			end
			if n == "CreateKeybind" and c.HoldToInteract and not c.Mode then c.Mode = "Hold" end
			if n == "CreateInput" and c.RemoveTextAfterFocusLost then c.ClearAfter = true end
			if (n == "CreateSlider" or n == "CreateRangeSlider") and c.Range == nil then c.Range = {c.Min or 0, c.Max or 100} end
			return c
		end
		for _, n in ipairs(ELEMENT_NAMES) do
			local orig = section[n]
			if orig then section[n] = function(self2, c) return orig(self2, normCfg(n, c)) end end
		end
	end

