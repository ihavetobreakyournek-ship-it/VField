local function make(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props or {}) do i[k] = v end
	i.Parent = parent
	return i
end
local function P(inst, map)
	hook(function() for prop, key in pairs(map) do inst[prop] = COLORS[key] end end)
	return inst
end
local function tween(i, d, props, style, dir)
	local t = TweenService:Create(i, TweenInfo.new(d, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end
local function loop(i, d, props, style, reverse)
	local t = TweenService:Create(i, TweenInfo.new(d, style or Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, reverse or false), props)
	t:Play()
	return t
end
local function stroke(i, color, tr, th)
	return make("UIStroke", {Color = color or COLORS.Line, Transparency = tr or 0, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, i)
end
local function T(parent, text, size, col, font, pos, dim)
	local l = make("TextLabel", {BackgroundTransparency = 1, Font = font or FONT, Text = text or "", TextSize = size or 13,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		Position = pos or UDim2.new(), Size = dim or UDim2.new(1, 0, 0, 20)}, parent)
	if typeof(col) == "Color3" then l.TextColor3 = col else P(l, {TextColor3 = col or "Text"}) end
	return l
end
local function B(parent, text, pos, dim, bg)
	local b = make("TextButton", {AutoButtonColor = false, BorderSizePixel = 0, Font = FONT_BOLD, Text = text or "", TextSize = 12,
		Position = pos or UDim2.new(), Size = dim or UDim2.new(1, 0, 0, 34)}, parent)
	P(b, {BackgroundColor3 = bg or "Raised", TextColor3 = "Text"})
	return b
end
local function list(parent, pad)
	return make("UIListLayout", {Padding = UDim.new(0, pad or 8), SortOrder = Enum.SortOrder.LayoutOrder}, parent)
end
local function strip(t) return (tostring(t or ""):gsub("<[^>]*>", "")) end
local function measure(text, size, font, width)
	local clean = strip(text)
	if clean:gsub("%s", "") == "" then return 0 end
	local ok, b = pcall(function() return TextService:GetTextSize(clean, size, font, Vector2.new(math.max(width, 40), 10000)) end)
	return ok and b and b.Y or size + 2
end
local function playSound(kind, volMul, speedMul)
	if not snd.on or snd.vol <= 0 then return end
	local d = SOUNDS[kind]
	if not d then return end
	local s = make("Sound", {SoundId = d[1], Volume = d[2] * snd.vol * (volMul or 1), PlaybackSpeed = d[3] * (speedMul or 1)}, SoundService)
	s:Play()
	task.delay(3, function() if s.Parent then s:Destroy() end end)
end
local function getPlayerGui() return lp:FindFirstChildOfClass("PlayerGui") or lp:WaitForChild("PlayerGui") end
local function getGuiParent()
	local ok, hidden = pcall(function() return gethui and gethui() end)
	if ok and typeof(hidden) == "Instance" then return hidden end
	local okc, core = pcall(function() return game:GetService("CoreGui") end)
	if okc and core then
		local probe = Instance.new("Folder")
		local okp = pcall(function() probe.Parent = core end)
		local usable = okp and probe.Parent == core
		probe:Destroy()
		if usable then return core end
	end
	return getPlayerGui()
end
local function newScreen(name)
	local s = Instance.new("ScreenGui")
	s.Name, s.IgnoreGuiInset, s.ResetOnSpawn, s.DisplayOrder = name, true, false, 999999
	s.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	if syn and syn.protect_gui then pcall(syn.protect_gui, s) end
	s.Parent = getGuiParent()
	return s
end
local function pointer(i) return Vector2.new(i.Position.X, i.Position.Y + GuiService:GetGuiInset().Y) end
local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function inside(gui, p)
	local a, s = gui.AbsolutePosition, gui.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

