		function section:CreateDropdown(config)
			local mw, mh = COMPACT and 120 or 150, COMPACT and 34 or 28
			local row, lab, info = makeRow(self, config, mw + 28, 54)
			local multi = config.Multi == true
			local options = {}
			for _, o in ipairs(config.Options or {}) do options[#options + 1] = tostring(o) end
			local selected = {}
			local function setFrom(v)
				selected = {}
				if type(v) == "table" then for _, x in ipairs(v) do selected[tostring(x)] = true end
				elseif v ~= nil and v ~= "" then selected[tostring(v)] = true end
			end
			setFrom(config.CurrentOption or ((not multi) and options[1]) or nil)
			local function getValue()
				if multi then
					local t = {}
					for _, o in ipairs(options) do if selected[o] then t[#t + 1] = o end end
					return t
				end
				for _, o in ipairs(options) do if selected[o] then return o end end
			end
			local sel = B(row, "", UDim2.new(1, -(mw + 14), 0, 0), UDim2.fromOffset(mw, mh), "Panel")
			sel.ZIndex, sel.ClipsDescendants = 5, true
			info.VC(sel)
