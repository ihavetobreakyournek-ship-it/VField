
local URL = "https://raw.githubusercontent.com/ihavetobreakyournek-ship-it/VField/refs/heads/main/script"

local ok, src = pcall(function() return game:HttpGet(URL) end)
if not ok or type(src) ~= "string" or #src < 1000 then
	return warn("V Field: could not download the library")
end
local fn, err = loadstring(src)
if not fn then return warn("V Field: " .. tostring(err)) end
return fn()
